# 複製成 .env 並填入密碼：copy .env.example .env
# ── DB 超級使用者（initdb 用）──────────────────────────────
POSTGRES_USER=stock_admin
POSTGRES_PASSWORD=change_me_admin
POSTGRES_DB=stockdb

# ── 應用角色密碼（init SQL 於 T1 建立角色時帶入）──────────────
# stock_app：MCP/loader/ml 用，可寫學習表+行情表，無 DELETE/DDL
STOCK_APP_PASSWORD=change_me_app
# stock_readonly：API 用，唯讀
STOCK_READONLY_PASSWORD=change_me_readonly

# ── FinMind API token（台股中文名/產業別/籌碼，可留空用免登入額度）──
FINMIND_TOKEN=

# ── Discord Incoming Webhook（尾盤即時掃描 13:10 推播訊號用，留空則不推播）──
# 取得：Discord 伺服器 → 設定 → 整合 → Webhook → 建立 → 複製 Webhook URL
DISCORD_WEBHOOK_URL=

# ── 訂閱制登入/註冊（auth-agent）──────────────────────────────
# stock_auth：API 認證表專屬角色（只寫 auth 表，碰不到股票資料）
STOCK_AUTH_PASSWORD=change_me_auth
# JWT 簽章密鑰（請用長亂數，如 python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_SECRET=change_me_long_random_secret
# 試用天數
TRIAL_DAYS=14
# cookie Secure 旗標：本機 http 用 false；正式 https 必設 true
COOKIE_SECURE=false
# 寄信後端：console=印到 docker logs（dev）/ smtp=正式（需填下方 SMTP_*）
EMAIL_BACKEND=console
# 驗證/重設信連結用的對外網址
APP_BASE_URL=http://localhost:7004
# 正式寄信（EMAIL_BACKEND=smtp 時）：SendGrid/SES 走 SMTP relay
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@localhost
SMTP_TLS=true
