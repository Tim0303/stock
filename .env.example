# 複製成 .env 並填入密碼：copy .env.example .env
# ── DB 超級使用者（initdb 用）──────────────────────────────
POSTGRES_USER=stock_admin
POSTGRES_PASSWORD=change_me_admin
POSTGRES_DB=stockdb

# ── 應用角色密碼（init SQL 於 T1 建立角色時帶入）──────────────
# stock_app：MCP/loader/ml 用，可寫學習表+行情表，無 DELETE/DDL
STOCK_APP_PASSWORD=change_me_app
# stock_readonly：API 用，唯讀
STOCK_READONLY_PASSWORD=change_me_readonly

# ── FinMind API token（台股中文名/產業別/籌碼，可留空用免登入額度）──
FINMIND_TOKEN=

# ── Discord Incoming Webhook（尾盤即時掃描 13:10 推播訊號用，留空則不推播）──
# 取得：Discord 伺服器 → 設定 → 整合 → Webhook → 建立 → 複製 Webhook URL
DISCORD_WEBHOOK_URL=
